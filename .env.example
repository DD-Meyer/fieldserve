# Copy to .env and fill in real values. Real .env is gitignored.

# --- Postgres ---
POSTGRES_DB=fieldserve
POSTGRES_USER=fieldserve_user
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Comma-separated list of allowed CORS origins when DEBUG=0
DJANGO_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Clerk (backend) ---
# From Clerk dashboard -> API Keys
CLERK_SECRET_KEY=sk_test_replace_me
# JWKS endpoint for your Clerk instance, e.g. https://<your-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Optional: lock token audience/issuer
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Webhook signing secret from Clerk dashboard -> Webhooks
CLERK_WEBHOOK_SECRET=whsec_replace_me

# --- Internal services ---
ML_SERVICE_URL=http://ml:8001
# Shared secret for the ML service's /admin/* endpoints (retrain, reload).
# Leave empty to disable the admin endpoints (they will return 503).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_INTERNAL_TOKEN=

# --- Expo (only EXPO_PUBLIC_* are exposed to the client bundle) ---
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_URL=http://192.168.0.10:8001
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
