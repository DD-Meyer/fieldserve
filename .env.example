# Copy to .env for the local backend. Replace placeholders with development values;
# never commit the resulting .env or put server-side secrets in the Expo app.

# --- Postgres ---
POSTGRES_DB=fieldserve
POSTGRES_USER=fieldserve_user
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Comma-separated list of allowed CORS origins when DEBUG=0
DJANGO_CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081,http://192.168.0.10:8081

# --- Clerk (backend) ---
# From the same Clerk development instance used by fieldserve-crm/.env.local.
# Clerk dashboard -> API Keys. Keep this secret out of Git and the mobile app.
CLERK_SECRET_KEY=sk_test_replace_me
# JWKS endpoint for your Clerk instance, e.g. https://<your-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Optional: lock token audience/issuer
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional for the basic local sign-up/login flow. From Clerk dashboard -> Webhooks.
CLERK_WEBHOOK_SECRET=whsec_replace_me

# --- Internal services ---
ML_SERVICE_URL=http://ml:8001
# Shared secret for the ML service's /admin/* endpoints (retrain, reload).
# Leave empty to disable the admin endpoints (they will return 503).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_INTERNAL_TOKEN=
# Self-hosted OSRM instance used for road geometry; keep this internal-only and do not expose it publicly.
ROAD_ROUTER_URL=http://osrm:5000
# Optional server-side Google key for the current Places and Geocoding API endpoints.
# Never put this key in fieldserve-crm/.env.local or expose it to the mobile bundle.
GOOGLE_PLACES_SERVER_KEY=

# --- Expo reference values (Expo reads its own fieldserve-crm/.env.local) ---
# Copy fieldserve-crm/.env.example to fieldserve-crm/.env.local and set these there.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_URL=http://192.168.0.10:8001
# Must belong to the same Clerk instance as CLERK_SECRET_KEY/CLERK_JWKS_URL above.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Native only: absolute URL of the Clerk proxy. Required for the production instance, whose
# Frontend API host is unreachable; leave empty for dev instances (*.clerk.accounts.dev).
EXPO_PUBLIC_CLERK_PROXY_URL=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace_with_google_maps_js_key