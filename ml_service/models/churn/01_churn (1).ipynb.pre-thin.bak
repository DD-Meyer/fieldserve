   ],
   "source": [
    "# ── sanity check: reload from disk and reproduce a prediction ─────────────\n",
    "loaded = joblib.load(MODEL_PATH)\n",
    "loaded_model    = loaded['model']\n",
    "loaded_imputer  = loaded['imputer']\n",
    "loaded_features = loaded['feature_names']\n",
    "\n",
    "sample_row = feat[loaded_features].iloc[[0]]\n",
    "sample_imputed = loaded_imputer.transform(sample_row.values)\n",
    "sample_prob = loaded_model.predict_proba(sample_imputed)[0, 1]\n",
    "\n",
    "print(f'Reloaded model  : {loaded[\"model_name\"]} ({loaded[\"feature_set_label\"]}) trained on {loaded[\"data_source\"]}')\n",
    "print(f'Feature order   : {loaded_features}')\n",
    "print(f'Sample churn probability : {sample_prob:.4f}')\n",
    "print('\\n✓ Reload + predict succeeded — bundle is FastAPI-ready')"
   ]
  },
