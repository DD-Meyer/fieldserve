    "## 11  Precision-Recall & ROC Curves (Figure for §5.1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dfe01888",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x500 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Saved to outputs/churn_curves_retailii.png\n"
     ]
    }
   ],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "colours = ['#2196F3', '#4CAF50', '#FF9800', '#E91E63']\n",
    "\n",
    "for i, r in enumerate(results):\n",
    "    label = f\"{r['Model']} ({r['Features']}) — PR-AUC={r['PR-AUC']:.3f}\"\n",
    "    p, rec, _ = precision_recall_curve(y_test, r['_y_prob'])\n",
    "    axes[0].plot(rec, p, color=colours[i], label=label, linewidth=1.8)\n",
    "    fpr, tpr, _ = roc_curve(y_test, r['_y_prob'])\n",
    "    axes[1].plot(fpr, tpr, color=colours[i],\n",
    "                 label=f\"{r['Model']} ({r['Features']}) — AUC={r['ROC-AUC']:.3f}\",\n",
    "                 linewidth=1.8)\n",
    "\n",
    "axes[0].set_xlabel('Recall'); axes[0].set_ylabel('Precision')\n",
    "axes[0].set_title('Precision-Recall Curve (primary metric)')\n",
    "axes[0].legend(fontsize=8); axes[0].grid(alpha=0.3)\n",
    "\n",
    "axes[1].plot([0,1],[0,1],'k--', linewidth=1, label='Random baseline')\n",
    "axes[1].set_xlabel('False Positive Rate'); axes[1].set_ylabel('True Positive Rate')\n",
    "axes[1].set_title('ROC Curve')\n",
    "axes[1].legend(fontsize=8); axes[1].grid(alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(OUT_DIR / 'churn_curves_retailii.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print('Saved to outputs/churn_curves_retailii.png')"
   ]
  },
