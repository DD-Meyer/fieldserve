   "source": [
    "import pandas as pd\n",
    "\n",
    "# ── basic cleaning ──────────────────────────────────────────────────────────\n",
    "df = raw.copy()\n",
    "\n",
    "# 1. Invoice as string so we can check the cancellation prefix safely\n",
    "df['Invoice'] = df['Invoice'].astype(str)\n",
    "\n",
    "# 2. Drop rows with no customer ID — can't attribute these to a churn label\n",
    "df = df.dropna(subset=['Customer ID']).copy()\n",
    "\n",
    "# Safe numeric conversion for Customer ID (handles floats, strings with decimals, etc.)\n",
    "df['Customer ID'] = pd.to_numeric(df['Customer ID'], errors='coerce').astype(int).astype(str)\n",
    "\n",
    "# 3. Parse dates safely\n",
    "df['InvoiceDate'] = pd.to_datetime(df['InvoiceDate'], errors='coerce')\n",
    "\n",
    "# 4. Cancellation flag: Invoice starting with 'C' (or 'c')\n",
    "df['cancelled'] = df['Invoice'].str.upper().str.startswith('C').astype(int)\n",
    "\n",
    "# 5. Remove rows with non-positive price OR non-positive quantity on real (non-cancelled) lines\n",
    "# This prevents ghost adjustments and negative revenue on valid invoices\n",
    "valid_sales_mask = (df['cancelled'] == 0) & ((df['Price'] <= 0) | (df['Quantity'] <= 0))\n",
    "df = df[~valid_sales_mask].copy()\n",
    "\n",
    "# 6. Line-level revenue\n",
    "df['line_amount'] = df['Quantity'] * df['Price']\n",
    "\n",
    "# ── Verification Prints ──────────────────────────────────────────────────────\n",
    "print(f'Rows after cleaning: {len(df):,}')\n",
    "print(f'Date range: {df[\"InvoiceDate\"].min().date()} → {df[\"InvoiceDate\"].max().date()}')\n",
    "print(f'Unique customers: {df[\"Customer ID\"].nunique():,}')\n",
    "print(f'Unique invoices : {df[\"Invoice\"].nunique():,}')\n",
    "print(f'Cancellation rate (line-level): {df[\"cancelled\"].mean():.1%}')"
   ]
  },
