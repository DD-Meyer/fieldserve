   "source": [
    "from xgboost import XGBClassifier\n",
    "\n",
    "# NOTE: no scale_pos_weight — same reasoning as Random Forest above; SMOTE\n",
    "# already handles the imbalance for the training set used here.\n",
    "xgb = XGBClassifier(\n",
    "    n_estimators=500,\n",
    "    learning_rate=0.05,\n",
    "    max_depth=6,\n",
    "    subsample=0.8,\n",
    "    colsample_bytree=0.8,\n",
    "    eval_metric='aucpr',\n",
    "    random_state=RANDOM_STATE,\n",
    "    n_jobs=-1,\n",
    "    verbosity=0\n",
    ")\n",
    "xgb.fit(X_ext_train_res, y_train_res_ext,\n",
    "        eval_set=[(X_ext_test, y_test)],\n",
    "        verbose=False)\n",
    "evaluate('XGBoost', xgb, X_ext_test, y_test, 'Extended features')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ef7cc8af",
