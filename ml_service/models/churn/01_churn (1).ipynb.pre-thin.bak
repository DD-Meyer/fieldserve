    "def load_online_retail(data_dir: Path) -> pd.DataFrame:\n",
    "    \"\"\"Load Online Retail 2 from whichever distribution format is present.\"\"\"\n",
    "    xlsx_path = data_dir / 'online_retail_2.csv'\n",
    "    csv_candidates = list(data_dir.glob('*.csv'))\n",
    "\n",
    "    print(xlsx_path)\n",
    "\n",
    "    frames = []\n",
    "    if xlsx_path.exists():\n",
    "        print(f'Loading Excel distribution: {xlsx_path.name}')\n",
    "        xls = pd.ExcelFile(xlsx_path)\n",
    "        for sheet in xls.sheet_names:\n",
    "            frames.append(pd.read_excel(xls, sheet_name=sheet))\n",
    "    elif csv_candidates:\n",
    "        print(f'Loading CSV distribution: {[p.name for p in csv_candidates]}')\n",
    "        for p in csv_candidates:\n",
    "            frames.append(pd.read_csv(p, encoding='ISO-8859-1'))\n",
    "    else:\n",
    "        raise FileNotFoundError(\n",
    "            f'No online_retail_II.xlsx or *.csv found in {data_dir}. '\n",
    "            'Download from Kaggle/UCI and place the file(s) there.'\n",
    "        )\n",
    "\n",
    "    df = pd.concat(frames, ignore_index=True)\n",
    "\n",
    "    # normalise column name variants across distributions\n",
    "    rename_map = {\n",
    "        'InvoiceNo':   'Invoice',\n",
    "        'UnitPrice':   'Price',\n",
    "        'CustomerID':  'Customer ID',\n",
    "    }\n",
    "    df = df.rename(columns={k: v for k, v in rename_map.items() if k in df.columns})\n",
    "\n",
    "    required = ['Invoice', 'StockCode', 'Quantity', 'InvoiceDate', 'Price', 'Customer ID', 'Country']\n",
    "    missing = [c for c in required if c not in df.columns]\n",
    "    if missing:\n",
    "        raise KeyError(f'Missing expected columns after normalisation: {missing}. Found: {list(df.columns)}')\n",
    "\n",
    "    return df\n",
    "\n",
    "raw = load_online_retail(DATA_DIR)\n",
    "print(f'\\nRaw rows loaded: {len(raw):,}')\n",
    "raw.head(3)"
   ]
  },
