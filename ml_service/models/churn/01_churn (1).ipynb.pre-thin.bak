   "source": [
    "# ── aggregate to invoice (booking) level ───────────────────────────────────\n",
    "bookings = (\n",
    "    df.groupby(['Invoice', 'Customer ID'])\n",
    "      .agg(\n",
    "          booking_date  = ('InvoiceDate', 'first'),\n",
    "          invoice_amount= ('line_amount', 'sum'),\n",
    "          item_count    = ('StockCode', 'nunique'),\n",
    "          unit_count    = ('Quantity', 'sum'),\n",
    "          cancelled     = ('cancelled', 'max'),\n",
    "          country       = ('Country', 'first'),\n",
    "      )\n",
    "      .reset_index()\n",
    "      .rename(columns={'Invoice': 'booking_id', 'Customer ID': 'customer_id'})\n",
    ")\n",
    "\n",
    "print(f'Bookings (invoices) loaded: {len(bookings):,}')\n",
    "print(f'Unique customers: {bookings[\"customer_id\"].nunique():,}')\n",
    "print(f'Date range: {bookings[\"booking_date\"].min().date()} → {bookings[\"booking_date\"].max().date()}')\n",
    "bookings.head(3)"
   ]
