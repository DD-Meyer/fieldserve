   "metadata": {},
   "source": [
    "## 13  Churn Risk Buckets (UI integration)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "90097081",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Risk bucket distribution (test set, best model = Logistic Regression / Extended features):\n",
      "Low       221\n",
      "Medium    208\n",
      "High      177\n",
      "Name: count, dtype: int64\n",
      "  High: 177 customers, actual churn rate = 60.5%\n",
      "  Medium: 208 customers, actual churn rate = 29.3%\n",
      "  Low: 221 customers, actual churn rate = 10.0%\n"
     ]
    }
   ],
   "source": [
    "best_idx = results_df['PR-AUC'].idxmax()\n",
    "best_probs = results[best_idx]['_y_prob']\n",
    "\n",
    "def risk_bucket(p):\n",
    "    if p >= 0.65: return 'High'\n",
    "    if p >= 0.35: return 'Medium'\n",
    "    return 'Low'\n",
    "\n",
    "bucket_series = pd.Series(best_probs).apply(risk_bucket)\n",
    "print(f\"Risk bucket distribution (test set, best model = {results[best_idx]['Model']} / {results[best_idx]['Features']}):\")\n",
    "print(bucket_series.value_counts())\n",
    "\n",
    "for bucket in ['High', 'Medium', 'Low']:\n",
    "    mask = bucket_series == bucket\n",
    "    if mask.sum() > 0:\n",
    "        actual_churn = y_test[mask.values].mean()\n",
    "        print(f'  {bucket}: {mask.sum()} customers, actual churn rate = {actual_churn:.1%}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1c0a5fd0",
   "metadata": {},
   "source": [
    "## 14  Export Best Model for FastAPI (joblib)\n",
    "\n",
    "Same export protocol as the Olist notebook: a single bundle with the fitted model, a matched imputer, exact feature order, risk thresholds, and metadata — including a `data_source` field so the FastAPI service (and anyone reading the bundle later) knows which dataset trained this specific model."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0e1b507d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Best model by PR-AUC : Logistic Regression — Extended features\n",
      "PR-AUC=0.6173  ROC-AUC=0.7813  F1=0.5928  Brier=0.1951\n",
      "Feature set (17 features): ['recency_days', 'tenure_days', 'freq_12m', 'freq_3m', 'avg_inter_booking_gap', 'inter_booking_gap_std', 'total_spend_12m', 'avg_ticket', 'monetary_trend', 'spend_per_visit_std', 'spend_per_visit_cv', 'cancellation_rate', 'unique_item_types', 'total_units', 'weekend_share', 'evening_share', 'is_uk']\n",
      "\n",
      "Saved bundle → models\\churn_model.joblib\n",
      "File size: 3.1 KB\n"
     ]
    }
   ],
   "source": [
    "import joblib\n",
    "from datetime import datetime\n",
    "\n",
    "best_row = results_df.loc[best_idx]\n",
    "\n",
    "if 'RFM' in best_row['Features']:\n",
    "    best_model_obj   = lr_rfm\n",
    "    best_feature_set = RFM_FEATURES\n",
    "else:\n",
    "    lookup = {\n",
    "        'Logistic Regression': lr_ext,\n",
    "        'Random Forest':       rf,\n",
    "        'XGBoost':              xgb,\n",
    "    }\n",
    "    best_model_obj   = lookup[best_row['Model']]\n",
    "    best_feature_set = EXT_FEATURES\n",
    "\n",
    "print(f\"Best model by PR-AUC : {best_row['Model']} — {best_row['Features']}\")\n",
    "print(f\"PR-AUC={best_row['PR-AUC']}  ROC-AUC={best_row['ROC-AUC']}  F1={best_row['F1']}  Brier={best_row['Brier Score']}\")\n",
    "print(f\"Feature set ({len(best_feature_set)} features): {best_feature_set}\")\n",
    "\n",
    "export_imputer = SimpleImputer(strategy='median')\n",
    "export_imputer.fit(feat[best_feature_set].values)\n",
    "\n",
    "bundle = {\n",
    "    'model':             best_model_obj,\n",
    "    'imputer':           export_imputer,\n",
    "    'feature_names':     best_feature_set,\n",
    "    'model_name':        best_row['Model'],\n",
    "    'feature_set_label': best_row['Features'],\n",
    "    'data_source':       'UCI Online Retail II',\n",
    "    'metrics': {\n",
    "        'pr_auc':      float(best_row['PR-AUC']),\n",
    "        'roc_auc':     float(best_row['ROC-AUC']),\n",
    "        'f1':          float(best_row['F1']),\n",
    "        'brier_score': float(best_row['Brier Score']),\n",
    "    },\n",
    "    'risk_bucket_thresholds': {'high': 0.65, 'medium': 0.35},\n",
    "    'churn_definition': {\n",
    "        'window_days':             CHURN_DAYS,\n",
    "        'observation_window_days': 365,\n",
    "        'cutoff_date_used_in_training': str(CUTOFF.date()),\n",
    "    },\n",
    "    'trained_at':   datetime.now().isoformat(),\n",
    "    'sklearn_note': 'pin the same scikit-learn major version in the FastAPI service requirements.txt to avoid unpickling issues',\n",
    "}\n",
    "\n",
    "MODEL_PATH = MODEL_DIR / 'churn_model.joblib'\n",
    "joblib.dump(bundle, MODEL_PATH)\n",
    "\n",
    "print(f'\\nSaved bundle → {MODEL_PATH}')\n",
    "print(f'File size: {MODEL_PATH.stat().st_size / 1024:.1f} KB')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6476edee",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Reloaded model  : Logistic Regression (Extended features) trained on UCI Online Retail II\n",
      "Feature order   : ['recency_days', 'tenure_days', 'freq_12m', 'freq_3m', 'avg_inter_booking_gap', 'inter_booking_gap_std', 'total_spend_12m', 'avg_ticket', 'monetary_trend', 'spend_per_visit_std', 'spend_per_visit_cv', 'cancellation_rate', 'unique_item_types', 'total_units', 'weekend_share', 'evening_share', 'is_uk']\n",
