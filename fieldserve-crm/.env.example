# Copy to .env.local. Values here are bundled into the client only when prefixed EXPO_PUBLIC_.
# For a physical phone, replace this host with the development computer's LAN IPv4 address.
EXPO_PUBLIC_API_URL=http://192.168.1.25:8000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Leave blank for a Clerk development instance.
EXPO_PUBLIC_CLERK_PROXY_URL=
# Optional: required for Google Maps display and Google Places address suggestions.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
