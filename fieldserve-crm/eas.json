{
  "cli": {
    "version": ">= 21.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.13.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.0.10:8000",
        "EXPO_PUBLIC_URL": "http://192.168.0.10:8000"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "24.13.0",
      "env": {
        "EXPO_PUBLIC_CLERK_PROXY_URL": "https://fieldserve.vercel.app/__clerk",
        "EXPO_PUBLIC_API_URL": "https://fieldserve-backend.onrender.com",
        "EXPO_PUBLIC_URL": "https://fieldserve.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "24.13.0",
      "env": {
        "EXPO_PUBLIC_CLERK_PROXY_URL": "https://fieldserve.vercel.app/__clerk",
        "EXPO_PUBLIC_API_URL": "https://fieldserve-backend.onrender.com",
        "EXPO_PUBLIC_URL": "https://fieldserve.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
